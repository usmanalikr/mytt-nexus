# Names only. Never put a real value in this file.
# Secrets live in Edge Function secrets, or in the cloud environment's
# network secrets. See docs/cloud-setup.md.

# --- Public by design ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<the project's anon key; public by design>

# --- Ingest (slice 1) ---
# Sent as the X-Brain-Ingest-Token header, never as Authorization (D12).
# In the cloud environment this is a network secret for the project host,
# so it is not set here at all.
BRAIN_INGEST_TOKEN=

# --- Set as Edge Function secrets, not here. Listed so the names are in one place. ---
# BRAIN_INTAKE_DB_URL        connection for the brain_intake role
# BRAIN_CURATOR_DB_URL       connection for the brain_curator role
# CF_ACCOUNT_ID              Cloudflare account id
# CF_API_TOKEN               Cloudflare API token, Workers AI scope only
# CF_MODEL                   default @cf/google/gemma-4-26b-a4b-it
# CURATOR_BATCH_SIZE         default 3
# CURATOR_PUBLISH_ENABLED    off until AC17 passes
