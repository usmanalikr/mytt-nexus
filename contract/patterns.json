{
  "version": "1.0.0",
  "note": "The single source of the screen's patterns, read by brain/screen.py, brain-ingest and brain-curator so the three screens cannot drift apart (D6). Regexes use only syntax that both Python `re` and JavaScript `RegExp` accept: no named groups, no inline flags, no atomic groups. Flags are given separately. `allow` is applied first and its matches are protected from every rule below.",
  "allow": [
    {
      "id": "ticket-id",
      "pattern": "\\b[A-Z]{2,10}-\\d{1,6}\\b",
      "flags": "g",
      "note": "DEV-39397 and the like must survive (AC4)."
    },
    {
      "id": "iso-date",
      "pattern": "\\b\\d{4}-\\d{2}-\\d{2}\\b",
      "flags": "g"
    },
    {
      "id": "version",
      "pattern": "\\bv\\d+\\.\\d+(?:\\.\\d+)*\\b|\\b\\d+\\.\\d+\\.\\d+\\b",
      "flags": "g",
      "note": "Requires a v prefix, or three parts. An earlier two-part form protected decimal money amounts such as 42,000.50 and hour counts such as 37.5, which stopped the money rules firing."
    },
    {
      "id": "clock-time",
      "pattern": "\\b\\d{1,2}:\\d{2}(?::\\d{2})?\\b",
      "flags": "g"
    },
    {
      "id": "percentage",
      "pattern": "\\b\\d+(?:\\.\\d+)?%",
      "flags": "g"
    },
    {
      "id": "issue-ref",
      "pattern": "#\\d{1,6}\\b",
      "flags": "g"
    }
  ],
  "rules": [
    {
      "id": "pem-private-key",
      "category": "secret",
      "replacement": "[redacted: key]",
      "flags": "g",
      "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z ]*PRIVATE KEY-----"
    },
    {
      "id": "jwt",
      "category": "secret",
      "replacement": "[redacted: token]",
      "flags": "g",
      "pattern": "\\beyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}"
    },
    {
      "id": "prefixed-key",
      "category": "secret",
      "replacement": "[redacted: key]",
      "flags": "g",
      "pattern": "\\b(?:sbp|sb|sk|pk|rk|glpat|ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{16,}\\b"
    },
    {
      "id": "github-pat",
      "category": "secret",
      "replacement": "[redacted: key]",
      "flags": "g",
      "pattern": "\\bgithub_pat_[A-Za-z0-9_]{20,}\\b"
    },
    {
      "id": "slack-token",
      "category": "secret",
      "replacement": "[redacted: token]",
      "flags": "g",
      "pattern": "\\bxox[baprs]-[A-Za-z0-9-]{10,}\\b"
    },
    {
      "id": "aws-access-key",
      "category": "secret",
      "replacement": "[redacted: key]",
      "flags": "g",
      "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b"
    },
    {
      "id": "google-api-key",
      "category": "secret",
      "replacement": "[redacted: key]",
      "flags": "g",
      "pattern": "\\bAIza[0-9A-Za-z_-]{35,}\\b",
      "note": "At least 35, not exactly 35: a Google key one character off the canonical length would otherwise pass straight through, and over-redacting a long AIza-prefixed token is the safe direction for a secret."
    },
    {
      "id": "url-with-credentials",
      "category": "secret",
      "replacement": "[redacted: connection string]",
      "flags": "g",
      "pattern": "\\b(?:postgres(?:ql)?|mysql|mongodb(?:\\+srv)?|redis|amqps?|https?)://[^\\s/@:]+:[^\\s/@]+@\\S+"
    },
    {
      "id": "assigned-secret",
      "category": "secret",
      "replacement": "[redacted: credential]",
      "flags": "gi",
      "pattern": "\\b(?:password|passwd|secret|api[_-]?key|access[_-]?token|bearer)\\b\\s*[:=]\\s*[\"']?[^\\s\"',;]{8,}"
    },
    {
      "id": "email",
      "category": "personal",
      "replacement": "[redacted: email]",
      "flags": "g",
      "pattern": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b"
    },
    {
      "id": "phone-tt",
      "category": "personal",
      "replacement": "[redacted: phone]",
      "flags": "g",
      "pattern": "\\+1[\\s.-]?\\(?868\\)?[\\s.-]?\\d{3}[\\s.-]?\\d{4}\\b"
    },
    {
      "id": "phone-pk",
      "category": "personal",
      "replacement": "[redacted: phone]",
      "flags": "g",
      "pattern": "\\+92[\\s.-]?\\d{3}[\\s.-]?\\d{7}\\b"
    },
    {
      "id": "phone-intl",
      "category": "personal",
      "replacement": "[redacted: phone]",
      "flags": "g",
      "pattern": "\\+\\d{1,3}[\\s.-]?\\d{2,4}[\\s.-]?\\d{3,4}[\\s.-]?\\d{3,4}\\b"
    },
    {
      "id": "iban",
      "category": "personal",
      "replacement": "[redacted: account number]",
      "flags": "g",
      "pattern": "\\b[A-Z]{2}\\d{2}[A-Z0-9]{11,30}\\b"
    },
    {
      "id": "card-number",
      "category": "personal",
      "replacement": "[redacted: account number]",
      "flags": "g",
      "pattern": "\\b\\d{4}[ -]\\d{4}[ -]\\d{4}[ -]\\d{4}\\b"
    },
    {
      "id": "long-digit-run",
      "category": "personal",
      "replacement": "[redacted: id]",
      "flags": "g",
      "pattern": "\\b\\d{9,}\\b"
    },
    {
      "id": "rate",
      "category": "money",
      "replacement": "[redacted: rate]",
      "flags": "gi",
      "pattern": "(?:USD|TTD|PKR|GBP|EUR|Rs\\.?|\\$|£|€|₨)?\\s?\\b\\d[\\d,]*(?:\\.\\d{1,2})?\\s?(?:per|/)\\s?(?:hour|hr|day|week|month|sprint)\\b"
    },
    {
      "id": "currency-prefixed",
      "category": "money",
      "replacement": "[redacted: amount]",
      "flags": "gi",
      "pattern": "(?:USD|TTD|PKR|GBP|EUR|Rs\\.?|\\$|£|€|₨)\\s?\\d[\\d,]*(?:\\.\\d{1,2})?\\b"
    },
    {
      "id": "currency-suffixed",
      "category": "money",
      "replacement": "[redacted: amount]",
      "flags": "gi",
      "pattern": "\\b\\d[\\d,]*(?:\\.\\d{1,2})?\\s?(?:USD|TTD|PKR|GBP|EUR|dollars?|rupees?)\\b"
    },
    {
      "id": "hours-billed",
      "category": "money",
      "replacement": "[redacted: hours billed]",
      "flags": "gi",
      "pattern": "\\b(?:billed\\s+\\d[\\d,]*(?:\\.\\d+)?\\s?(?:hours?|hrs?)|\\d[\\d,]*(?:\\.\\d+)?\\s?(?:hours?|hrs?)\\s+billed|hours?\\s+billed)\\b"
    }
  ],
  "never_published": [
    "em_tracker.worklog_shortfalls",
    "em_tracker.member_notification_channels",
    "em_tracker.time_entries",
    "em_tracker.punctuality",
    "mytt.punctuality_tracker"
  ]
}
